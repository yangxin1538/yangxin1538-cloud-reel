# Generic deployment: any NAS or cloud server. See docs/DEPLOY.md.
# Host paths: relative by default; set absolute paths for your NAS/VPS.
PORT=8088
PUID=1000
PGID=1000
SOURCE_ROOT=/CloudNAS
STRM_ROOT=/strm/CloudReel
STRM_MODE=file
STRM_BASE_URL=
SCAN_INTERVAL_MINUTES=60
DATA_DIR=./data
CONFIG_DIR=./config
STRM_DIR=./strm
CLOUDNAS_DIR=./CloudNAS
EMBY_UPSTREAM=
CACHE_TTL_SECONDS=3600
# 123 open platform: apply at https://www.123pan.com/developer
PAN123_CLIENT_ID=
PAN123_CLIENT_SECRET=
# Membership is assumed for all drives (user, 2026-11-23): no membership
# gating in code. Guangya direct links need a Bearer auth_token on the
# source (captured from a logged-in session), not a membership check.
